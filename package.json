{
  "name": "docebo-microlearning-feed",
  "version": "0.1.0",
  "private": true,
  "description": "aTalent micro-learning feed: a vertical video feed for Docebo Channels, embedded via the Docebo iFrame widget.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply microlearning-feed --local",
    "db:migrate:remote": "wrangler d1 migrations apply microlearning-feed --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "discover": "node scripts/discover.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250405.0",
    "typescript": "5.6.3",
    "vitest": "2.1.8",
    "wrangler": "3.114.0"
  }
}
